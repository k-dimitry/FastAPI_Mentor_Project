# --- Database (Postgres) ---
# Для локального запуска (docker compose / uvicorn на хосте): localhost
# Внутри docker-compose app-сервиса переопределяется на db:5432
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/mydb"
DATABASE_ECHO=false

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# --- JWT ---
# Сгенерировать: openssl rand -base64 32
JWT_SECRET_KEY="change-me-in-production-min-32-chars"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- Redis (cache + rate limit) ---
# Для docker-compose: redis://redis:6379/0
# Для локального uvicorn на хосте: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# --- Cache ---
CACHE_TTL_SECONDS=60

# --- Rate limit (fixed window) ---
# Не более RATE_LIMIT_N запросов за RATE_LIMIT_T секунд
RATE_LIMIT_N=60
RATE_LIMIT_T=60

# --- Gunicorn ---
# Количество воркеров. Ориентир: 2 * CPU + 1, но с учётом памяти.
# Для 2-ядерного VPS разумно 4.
WEB_CONCURRENCY=4

# В docker-compose переопределяется на db:5432 / redis:6379
# Локально (uvicorn/celery на хосте): localhost:5432 / localhost:6379
# Для prod-драйвера — psycopg2 (sync); async-драйвер выше в DATABASE_URL
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/mydb

# Брокер и result backend в Redis, в разных DB:
#   /0 — cache + rate limit
#   /1 — Celery broker
#   /2 — Celery result backend
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# True — задачи выполняются синхронно (без брокера). Только для тестов.
CELERY_TASK_ALWAYS_EAGER=false